<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <DutyDef>
    <defName>WCTM_SingleCombatDuel</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="WhoCookThisMeal.JobGiver_WCTMSafeDuel" />
      </subNodes>
    </thinkNode>
  </DutyDef>
  <DutyDef>
    <defName>WCTM_SingleCombatStand</defName>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="WhoCookThisMeal.JobGiver_WCTMSingleCombatMove" />
      </subNodes>
    </thinkNode>
  </DutyDef>

  <HediffDef>
    <defName>WCTM_CookComa</defName>
    <label>Duel coma</label>
    <description>A brief coma after losing the duel.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="WhoCookThisMeal.HediffCompPropertiesWCTMCookComa">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>WCTM_EaterComa</defName>
    <label>Duel coma</label>
    <description>A brief coma after losing the duel.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>WCTM_CarefulCooking</defName>
    <label>Careful cooking</label>
    <description>Meals made by this pawn cannot cause food poisoning.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>180000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <HediffDef>
    <defName>WCTM_MechCookingUpgrade</defName>
    <label>Cooking chip overclock</label>
    <description>This mechanoid's cooking chip is overclocked and prevents food poisoning.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>60000</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>
  <SoundDef>
    <defName>WCTM_SingleCombatMusic</defName>
    <context>MapOnly</context>
    <maxVoices>1</maxVoices>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustain>true</sustain>
    <eventNames />
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>aizo</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>
  <SoundDef>
    <defName>WCTM_SingleCombatMusicAlt</defName>
    <context>MapOnly</context>
    <maxVoices>1</maxVoices>
    <priorityMode>PrioritizeNearest</priorityMode>
    <sustain>true</sustain>
    <eventNames />
    <subSounds>
      <li>
        <grains>
          <li Class="AudioGrain_Clip">
            <clipPath>aizo</clipPath>
          </li>
        </grains>
      </li>
    </subSounds>
  </SoundDef>
  <RitualBehaviorDef>
    <defName>WCTM_SingleCombat</defName>
    <workerClass>WhoCookThisMeal.RitualBehaviorWorkerWCTMSingleCombat</workerClass>
    <durationTicks>5000~5000</durationTicks>
    <roles>
      <li Class="WhoCookThisMeal.RitualRoleWCTMCook"><label>Cook</label><categoryLabel>Cook</categoryLabel><id>cook</id><required>true</required><maxCount>1</maxCount></li>
      <li Class="WhoCookThisMeal.RitualRoleWCTMEater"><label>Eater</label><categoryLabel>Eater</categoryLabel><id>eater</id><required>true</required><maxCount>1</maxCount></li>
    </roles>
    <stages>
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <endTriggers><li Class="StageEndTrigger_DurationPercentage"><percentage>1</percentage></li></endTriggers>
        <essential>true</essential>
        <visualEffectDef>Duel</visualEffectDef>
        <roleBehaviors>
          <li>
            <roleId>cook</roleId>
            <dutyDef>WCTM_SingleCombatStand</dutyDef>
            <customPositions>
              <li Class="WhoCookThisMeal.RitualPositionWCTMSide">
                <side>0</side>
              </li>
            </customPositions>
          </li>
          <li>
            <roleId>eater</roleId>
            <dutyDef>WCTM_SingleCombatStand</dutyDef>
            <customPositions>
              <li Class="WhoCookThisMeal.RitualPositionWCTMSide">
                <side>1</side>
              </li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
    <spectatorsLabel>Spectators</spectatorsLabel>
    <spectatorGerund>Watching the duel</spectatorGerund>
  </RitualBehaviorDef>
  <RitualBehaviorDef>
    <defName>WCTM_SingleCombatDuel</defName>
    <workerClass>WhoCookThisMeal.RitualBehaviorWorkerWCTMSingleCombat</workerClass>
    <durationTicks>5000~5000</durationTicks>
    <roles>
      <li Class="WhoCookThisMeal.RitualRoleWCTMCook"><label>Cook</label><categoryLabel>Cook</categoryLabel><id>cook</id><required>true</required><maxCount>1</maxCount></li>
      <li Class="WhoCookThisMeal.RitualRoleWCTMEater"><label>Eater</label><categoryLabel>Eater</categoryLabel><id>eater</id><required>true</required><maxCount>1</maxCount></li>
    </roles>
    <stages>
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <endTriggers><li Class="StageEndTrigger_DurationPercentage"><percentage>0.15</percentage></li></endTriggers>
        <roleBehaviors>
          <li><roleId>cook</roleId><dutyDef>Idle</dutyDef></li>
          <li><roleId>eater</roleId><dutyDef>Idle</dutyDef></li>
        </roleBehaviors>
      </li>
      <li>
        <defaultDuty>SpectateCircle</defaultDuty>
        <spectateDistanceOverride>5~7</spectateDistanceOverride>
        <endTriggers>
          <li Class="StageEndTrigger_DurationPercentage"><percentage>1</percentage></li>
          <li Class="StageEndTrigger_DuelEnded"><roleIds><li>cook</li><li>eater</li></roleIds></li>
        </endTriggers>
        <essential>true</essential>
        <visualEffectDef>Duel</visualEffectDef>
        <roleBehaviors>
          <li>
            <roleId>cook</roleId>
            <dutyDef>WCTM_SingleCombatDuel</dutyDef>
            <customPositions>
              <li Class="WhoCookThisMeal.RitualPositionWCTMSide"><side>0</side></li>
            </customPositions>
          </li>
          <li>
            <roleId>eater</roleId>
            <dutyDef>WCTM_SingleCombatDuel</dutyDef>
            <customPositions>
              <li Class="WhoCookThisMeal.RitualPositionWCTMSide"><side>1</side></li>
            </customPositions>
          </li>
        </roleBehaviors>
      </li>
    </stages>
    <spectatorsLabel>Spectators</spectatorsLabel>
    <spectatorGerund>Watching the duel</spectatorGerund>
  </RitualBehaviorDef>
  <RitualOutcomeEffectDef>
    <defName>WCTM_SingleCombat</defName>
    <workerClass>WhoCookThisMeal.RitualOutcomeEffectWorkerWCTMSingleCombat</workerClass>
    <comps>
      <li Class="RitualOutcomeComp_ParticipantCount"><label>participant count</label><curve><points><li>(1,0.07)</li><li>(4,0.22)</li><li>(7,0.33)</li><li>(10,0.4)</li></points></curve></li>
      <li Class="RitualOutcomeComp_RoomStat"><label>room impressiveness</label><statDef>Impressiveness</statDef><curve><points><li>(0,0)</li><li>(50,0.1)</li><li>(120,0.2)</li></points></curve></li>
      <li Class="WhoCookThisMeal.RitualOutcomeCompWCTMSkillDifference"><label>Melee skill difference</label></li>
    </comps>
    <outcomeChances>
      <li><label>Boring</label><chance>0.05</chance><positivityIndex>0</positivityIndex><memory>WCTM_SingleCombatBoring</memory></li>
      <li><label>Plain</label><chance>0.15</chance><positivityIndex>1</positivityIndex><memory>WCTM_SingleCombatPlain</memory></li>
      <li><label>Exciting</label><chance>0.60</chance><positivityIndex>2</positivityIndex><memory>WCTM_SingleCombatExciting</memory></li>
      <li><label>Unforgettable</label><chance>0.20</chance><positivityIndex>3</positivityIndex><memory>WCTM_SingleCombatUnforgettable</memory></li>
    </outcomeChances>
  </RitualOutcomeEffectDef>
  <RitualPatternDef>
    <defName>WCTM_SingleCombat</defName>
    <canStartAnytime>true</canStartAnytime>
    <ritualObligationTargetFilter>GatheringSpotOrAltar</ritualObligationTargetFilter>
    <ritualBehavior>WCTM_SingleCombat</ritualBehavior>
    <ritualOutcomeEffect>WCTM_SingleCombat</ritualOutcomeEffect>
  </RitualPatternDef>
  <PreceptDef>
    <defName>WCTM_SingleCombat</defName><label>Duel</label><description>The cook and eater engage in a harmless duel.</description><issue>Ritual</issue><impact>Medium</impact><preceptClass>Precept_Ritual</preceptClass><ritualPatternBase>WCTM_SingleCombat</ritualPatternBase><useRepeatPenalty>false</useRepeatPenalty>
  </PreceptDef>
</Defs>